# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env on your production server
# and adjust the values according to your setup

APP_NAME="RSM"
APP_ENV=production
APP_KEY=base64:RQ2zgB8h2UYH1ixLobmUxJguHyiedQOZRPjvmTREKiM=
APP_DEBUG=false
APP_TIMEZONE="Asia/Makassar"
APP_LOCALE=id
APP_URL=https://your-domain.com

APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Higher bcrypt rounds for production security
BCRYPT_ROUNDS=12

# Logging - less verbose for production
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database - Use connection pooling if available
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_rsm
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ===========================================
# PERFORMANCE OPTIMIZATIONS
# ===========================================

# Session - Use file for better performance (or redis if available)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue - Use database or redis
QUEUE_CONNECTION=database

# Cache - Use file for better performance (or redis if available)
# 'file' is faster than 'database' for most use cases
CACHE_STORE=file
CACHE_PREFIX=rsm_

MEMCACHED_HOST=127.0.0.1

# Redis Configuration (recommended for production)
# Uncomment and configure if Redis is available
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
